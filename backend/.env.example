# ROOT 404 — API configuration (copy to .env and adjust)

# DEBUG=true exposes the OTP code in /auth/otp responses (dev only — never in prod)
DEBUG=true

# SQLite by default (zero setup). Point at PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg2://root404:root404@localhost:5432/root404
# (then: pip install "psycopg2-binary")
DATABASE_URL=sqlite:///./data/root404.db

# JWT signing — use a long random string in production
JWT_SECRET=dev-only-change-me-424242-root404-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_DAYS=7

# OTP behaviour
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60

# Comma-separated origins, or * for any origin (dev)
CORS_ORIGINS=*
