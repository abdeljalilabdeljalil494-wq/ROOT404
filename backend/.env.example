# ROOT 404 Backend Environment Variables

# Security
SECRET_KEY=root404-dev-secret-key-change-in-production-32chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# For local dev with SQLite:
DATABASE_URL=sqlite:///./root404.db
# For production with Postgres:
# DATABASE_URL=postgresql://root404:root404_secret@localhost:5432/root404

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:4173"]

# Judge / Sandbox
JUDGE_ENABLED=false
JUDGE_TIMEOUT=30
JUDGE_MEMORY_LIMIT=512m
JUDGE_CPU_LIMIT=1.0

# AI Mentor
AI_PROVIDER=mock
# OPENAI_API_KEY=sk-...

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Black Hole
BLACKHOLE_WARNING_DAYS=7
