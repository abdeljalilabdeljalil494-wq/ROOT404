# Dedicated worker TLS ingress, private network/firewall only. Obtain real certs
# from your operator; this file is NOT a verified deployed certificate setup.
server {
    listen 8443 ssl;
    server_name executor.internal.example;
    ssl_certificate /etc/root404/tls/server.pem;
    ssl_certificate_key /etc/root404/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    client_body_timeout 10s;
    access_log off;
    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_read_timeout 100s;
        proxy_send_timeout 15s;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
    }
}
