# ROOT404 Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# === Security - REQUIRED IN PRODUCTION ===
SECRET_KEY=change-me-to-a-secure-random-key-min-32-chars
# Generate with: openssl rand -hex 32

# === Database ===
POSTGRES_USER=root404
POSTGRES_PASSWORD=change-me-to-strong-password
POSTGRES_DB=root404
DATABASE_URL=postgresql://root404:change-me-to-strong-password@db:5432/root404
# For local dev without docker: sqlite:///./root404.db

# === Redis ===
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# === Environment ===
ENVIRONMENT=development
# Options: development, staging, production
# In production: dev_otp disabled, stricter security headers, HSTS enabled

# === Frontend ===
VITE_API_URL=/api
VITE_USE_MOCK=false
# VITE_USE_MOCK=true for frontend-only dev without backend

# === Judge Sandbox ===
JUDGE_TIMEOUT=30
JUDGE_MEMORY_LIMIT=512m
JUDGE_CPU_LIMIT=1.0
JUDGE_MAX_FILE_SIZE=1048576
JUDGE_MAX_FILES=20
JUDGE_MAX_TOTAL_SIZE=5242880

# === Rate Limiting ===
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_JUDGE=20
RATE_LIMIT_JUDGE_WINDOW=60
RATE_LIMIT_SEARCH=30
RATE_LIMIT_SEARCH_WINDOW=60

# === CORS ===
# Comma-separated list of allowed origins
# In production, set to your frontend domain
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# === Email (for OTP) ===
# In production, configure SMTP for sending OTP emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@root404.tn
SMTP_PASSWORD=change-me
SMTP_FROM=noreply@root404.tn

# === Monitoring ===
# Sentry for error tracking (optional)
SENTRY_DSN=

# === Optional ===
# LOG_LEVEL=INFO
# DEBUG=false
