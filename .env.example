# ─────────────────────────────────────────────────────────────────────────────
# ROOT 404 — environment template
#
# One-time setup (NEVER commit your real .env — it is git-ignored):
#
#   Linux/macOS :  cp .env.example .env
#   PowerShell  :  Copy-Item .env.example .env
#
# Then generate strong values for the two REQUIRED secrets and paste them in:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   # or: openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# "development" | "production".
# Production refuses to start unless: SECRET_KEY is strong (>= 32 chars, not
# the dev placeholder) AND DATABASE_URL points at PostgreSQL (enforced in
# backend/app/core/config.py).
ENVIRONMENT=development

# REQUIRED. Secret used to sign authentication tokens. Generate a unique,
# strong value — do NOT reuse the development placeholder anywhere:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# REQUIRED (used by the `db` Compose service and the backend DATABASE_URL).
# Generate a strong value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_USER=root404
POSTGRES_DB=root404

# Ports published on the host machine.
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Comma-separated browser origins allowed by the backend CORS policy.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ── Usually left at defaults ─────────────────────────────────────────────────
# Inside Compose these are injected automatically (PostgreSQL + Redis services).
# Running the backend OUTSIDE Compose: SQLite is the default for quick local
# dev (NOT for production) and Redis is optional — health reports "degraded"
# without it.
# DATABASE_URL=postgresql+psycopg2://root404:CHANGE-ME@localhost:5432/root404
# REDIS_URL=redis://localhost:6379/0

# Insert the demo project catalogue on startup (idempotent — safe on restarts).
SEED_DEMO_DATA=true

# Abuse protection (per-IP, per minute window).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_WINDOW=10
RATE_LIMIT_REGISTER_PER_WINDOW=10
RATE_LIMIT_SUBMIT_PER_WINDOW=30

# Maximum accepted JSON request body (bytes).
MAX_BODY_BYTES=1048576
