# ─────────────────────────────────────────────────────────────────────────────
# ROOT 404 — environment template
#
# One-time setup (NEVER commit your real .env — it is git-ignored):
#
#   Linux/macOS :  cp .env.example .env
#   PowerShell  :  Copy-Item .env.example .env
#
# Then generate strong values for the two REQUIRED secrets and paste them in:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   # or: openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# "development" | "production".
# In production the backend refuses to start unless SECRET_KEY is set and at
# least 32 characters long (enforced in backend/app/core/config.py).
ENVIRONMENT=development

# REQUIRED. Secret used to sign authentication tokens. Generate a unique,
# strong value — do NOT reuse the development placeholder anywhere:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# REQUIRED (used by the `db` Compose service). Generate a strong value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_USER=root404
POSTGRES_DB=root404

# Ports published on the host machine.
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Comma-separated browser origins allowed by the backend CORS policy.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
