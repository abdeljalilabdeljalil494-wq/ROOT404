# Copy to .env; never commit the filled file. Generate random secrets locally.
ENVIRONMENT=development
SECRET_KEY=
DATABASE_URL=sqlite:///./root404.db
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SEED_DEMO_DATA=false
ENABLE_DEMO_FEATURES=false
EMAIL_PROVIDER=development
# Explicit opt-in for disposable local development ONLY; false by default.
ENABLE_DEV_OTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=60
JUDGE_ENABLED=false
# Approved immutable worker image digest, required before enabling judging.
JUDGE_EXPECTED_IMAGE=
JUDGE_URL=
JUDGE_SHARED_SECRET=
AI_PROVIDER=disabled
AI_MODEL=gpt-4o-mini
AI_REQUESTS_PER_HOUR=30
OPENAI_API_KEY=
# Compose production requires these, ENVIRONMENT=production, EMAIL_PROVIDER=smtp,
# and valid SMTP_HOST/SMTP_FROM. Passwords in database URLs must be percent-encoded.
POSTGRES_USER=root404
POSTGRES_DB=root404
POSTGRES_PASSWORD=
REDIS_URL=
REDIS_PASSWORD=

# Operator-scheduled retention; CLI is dry-run unless --apply.
MENTOR_RETENTION_DAYS=30
SUBMISSION_RETENTION_DAYS=90
MESSAGE_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=90
# Private in-app alert retention; operator purge is explicit, never on startup.
NOTIFICATION_RETENTION_DAYS=90

# Optional OAuth. Use exact HTTPS origin/oauth/callback/google or /github.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
